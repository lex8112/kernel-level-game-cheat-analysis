# Kernel Analysis & Reverse Engineering Environment Config

# Debugger Paths
WINDBG_PATH="C:\Program Files\Windows Kits\10\Debuggers\x64\windbg.exe"
PROCMON_CONFIG_PATH="./config/procmon_filters.pmc"

# Target Process Info
TARGET_GAME_NAME="game.exe"
ENABLE_KERNEL_HOOKS=true
ANALYSIS_MODE=strict

# Sırlar (Asla gerçek repoya yüklenmez)
API_TELEMETRY_KEY=insert_key_here
